{
  "name": "@glitch-guy0/shikigami",
  "version": "0.1.0",
  "description": "TypeScript Agent SDK with hexagonal architecture — core defines ports, adapters are injected",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./core": {
      "import": "./dist/core/index.mjs",
      "types": "./dist/core/index.d.mts"
    },
    "./guardrails": {
      "import": "./dist/guardrails/index.mjs",
      "types": "./dist/guardrails/index.d.mts"
    },
    "./tools": {
      "import": "./dist/tools/index.mjs",
      "types": "./dist/tools/index.d.mts"
    },
    "./reasoning": {
      "import": "./dist/reasoning/index.mjs",
      "types": "./dist/reasoning/index.d.mts"
    },
    "./delegation": {
      "import": "./dist/delegation/index.mjs",
      "types": "./dist/delegation/index.d.mts"
    },
    "./retrieval": {
      "import": "./dist/retrieval/index.mjs",
      "types": "./dist/retrieval/index.d.mts"
    },
    "./session": {
      "import": "./dist/session/index.mjs",
      "types": "./dist/session/index.d.mts"
    },
    "./streaming": {
      "import": "./dist/streaming/index.mjs",
      "types": "./dist/streaming/index.d.mts"
    },
    "./kairo": {
      "import": "./dist/kairo/index.mjs",
      "types": "./dist/kairo/index.d.mts"
    },
    "./kairo/memory": {
      "import": "./dist/kairo/memory/index.mjs",
      "types": "./dist/kairo/memory/index.d.mts"
    },
    "./kairo/tools": {
      "import": "./dist/kairo/tools/index.mjs",
      "types": "./dist/kairo/tools/index.d.mts"
    },
    "./kairo/reasoning": {
      "import": "./dist/kairo/reasoning/index.mjs",
      "types": "./dist/kairo/reasoning/index.d.mts"
    },
    "./kairo/guardrails": {
      "import": "./dist/kairo/guardrails/index.mjs",
      "types": "./dist/kairo/guardrails/index.d.mts"
    }
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.d.mts",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "agent",
    "sdk",
    "llm",
    "ai",
    "hexagonal",
    "ports-and-adapters"
  ],
  "license": "Apache-2.0",
  "author": "Glitch-guy0 <prajwal9845@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glitch-guy0/shikigami-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Glitch-guy0/shikigami-sdk/issues"
  },
  "homepage": "https://github.com/Glitch-guy0/shikigami-sdk#readme"
}
