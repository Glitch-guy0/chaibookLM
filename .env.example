QDRANT_API_KEY=

# ─── Cloudinary (file storage) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── LLM (OpenAI-compatible) ───
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Embeddings (OpenAI-compatible) ───
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ─── Tavily (Web search) ───
TAVILY_API_KEY=

# ─── Firecrawl (URL → markdown scraping) ───
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# ─── Upstash QStash (Ingestion queue) ───
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Rate Limiting ───
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=10000

# ─── App ───
UX_DEBUG=false