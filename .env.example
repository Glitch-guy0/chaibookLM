# ─── LLM (OpenAI-compatible) ───
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Embeddings (OpenAI-compatible) ───
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ─── Jina (Web search + reader) ───
JINA_API_KEY=

# ─── Upstash QStash (Ingestion queue) ───
