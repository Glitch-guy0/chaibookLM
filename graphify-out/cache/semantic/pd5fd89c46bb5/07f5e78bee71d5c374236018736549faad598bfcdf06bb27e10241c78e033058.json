{"nodes": [{"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine", "label": "Architecture Spine \u2014 chaibookLM v0.1", "file_type": "document", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": "2026-08-09", "author": null, "contributor": null}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad1", "label": "AD-1: Chunk data authority \u2014 Qdrant is system of record", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents split-store drift where a chunk exists in Neon but not Qdrant or vice versa; Neon stores only user/resource working metadata."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad2", "label": "AD-2: No rebuild on Qdrant loss", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents an unbounded, uncertain re-index operation after vector-store loss; zero backup posture in v0.1."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad3", "label": "AD-3: shikigami is coupled, not ported", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents a false abstraction over the answer runtime; SDK changes require an explicit change-request."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad4", "label": "AD-4: Single writer for the chunk lifecycle", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents orphaned vectors and divergent delete paths; only ingestion creates/removes chunks via filtered delete on sourceId."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad5", "label": "AD-5: One embedding model, both sides", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents mismatched vector spaces that make retrieval silently return garbage; EmbeddingService is the sole caller of the embeddings endpoint."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad6", "label": "AD-6: One shared chunk kernel, deterministically split", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents writer/reader/citation divergence; chunkId = deterministic hash(sourceId+position) makes QStash retries idempotent."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad7", "label": "AD-7: Citation contract \u2014 markers validated, never trusted", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents hallucinated or stale citations rendering; refusal is structural because no retrieval above minScore means no chunkIds in context."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad8", "label": "AD-8: Retrieval parameters (topK=5, minScore=0.30)", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents ad-hoc per-story tuning of the refusal gate; retrieval scoped by notebookId makes cross-notebook citations impossible by construction."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad9", "label": "AD-9: Chat history window \u2014 7 turns", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents unbounded per-turn token cost and full-history loads; resolved-citation snapshot carve-out lets old messages render chips despite AD-1."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad10", "label": "AD-10: Limits \u2014 one counter owner, atomic enforcement", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents divergent limit math and cap races; cap check-and-increment is a single Postgres transaction with a double-bump guard."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad11", "label": "AD-11: Notebook TTL is lazy", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents scheduler/infra cost for a low-frequency event; expiry checked lazily on dashboard load and notebook open, no cron in v0.1."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad12", "label": "AD-12: Honest degradation scoped to AI/ingestion ops", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents broken/erroring UI under load and unbounded queueing; already-indexed sources and browsing remain usable during rejection."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad13", "label": "AD-13: Web search is approval-gated, never unprompted", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents silent external fetches on every refusal and search firing without explicit user approval."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad14", "label": "AD-14: Delete cascade order Qdrant\u2192Filebase\u2192Neon", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents orphan chunks with live citations or half-deleted resources on failure; each step idempotent, tombstone check guards in-flight ingestion."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad15", "label": "AD-15: Qdrant hosting is a build decision, not a fork", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents two divergent Qdrant code paths (cloud vs self-hosted) living side by side; one adapter, env-driven."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_ad16", "label": "AD-16: Streaming answers via shikigami events", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents buffering the whole answer before showing anything; controller pulls shikigami's token stream and forwards deltas."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_architecture_spine_chunk_kernel", "label": "Shared Chunk Kernel {chunkId, sourceId, notebookId, span, position, text}", "file_type": "concept", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/ARCHITECTURE-SPINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_bmad_output_planning_art