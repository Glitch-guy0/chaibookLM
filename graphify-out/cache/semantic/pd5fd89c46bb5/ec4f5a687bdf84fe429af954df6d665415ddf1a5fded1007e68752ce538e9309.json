{"nodes": [{"id": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_proposal", "label": "Sprint Change Proposal: Chunk Data Authority, shikigami Coupling, backend/ Structure", "file_type": "document", "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_chunk_authority_decision", "label": "Decision: Qdrant as Chunk System of Record", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overrides the earlier lean of Neon-as-metadata-authority; Qdrant stores vector + chunk metadata together so retrieval and citation data stay co-located, with Neon reduced to working metadata only."}, {"id": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_recovery_policy_decision", "label": "Decision: No Rebuild-by-Replay Recovery Policy", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qdrant loss is not repaired by replaying ingestion since that would be costly/complex; approved recovery is to delete affected users' Filebase resource files and surface an honest error, accepting a zero-backup posture for builder-only v0.1."}, {"id": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_backend_tree_decision", "label": "Decision: backend/ as Separate Top-Level Tree", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping backend/ outside the Next.js app tree while remaining a single deployable allows the domain/application/infrastructure layers to be extracted into their own service later without a structural refactor."}], "edges": [{"source": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_proposal", "target": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_chunk_authority_decision", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "weight": 1.0}, {"source": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_proposal", "target": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_recovery_policy_decision", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "weight": 1.0}, {"source": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_proposal", "target": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_backend_tree_decision", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "weight": 1.0}, {"source": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_proposal", "target": "bmad_output_planning_artifacts_tech_stack_tech_stack_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "_bmad-output/planning-artifacts/sprint-change-proposal-2026-08-06.md", "source_location": null, "weight": 1.0}, {"source": "bmad_output_planning_artifacts_sprint_change_proposal_2026_08_06_proposal", "target": "bmad_output_planning_artifacts_prds_prd_chaibooklm_2026_08_04_addendu