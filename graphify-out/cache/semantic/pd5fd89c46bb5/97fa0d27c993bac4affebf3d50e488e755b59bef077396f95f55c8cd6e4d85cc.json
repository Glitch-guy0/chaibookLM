{"nodes": [{"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial", "label": "Adversarial Review \u2014 Architecture Spine", "file_type": "document", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial_h1", "label": "H1: chunkId determinism and span coordinate space undefined", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random chunkIds let QStash retries duplicate chunks; spans measured into the wrong buffer (raw vs rendered, UTF-16) misplace highlights."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial_h2", "label": "H2: AD-1 forbids the citation-render data AD-9 needs", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old paginated messages cannot resolve citation markers without either re-querying deleted Qdrant chunks or writing a Neon snapshot that literal AD-1 forbids."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial_h3", "label": "H3: Removal has no ordering/atomicity across Neon+Qdrant+Filebase", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A partial-failure delete order can leave stale chunks retrievable after a source is shown as removed."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial_h4", "label": "H4: In-flight QStash ingestion vs removal/lazy TTL orphan resurrect", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A late ingestion callback can resurrect chunks/rows for an already-deleted source or expired notebook."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial_h5", "label": "H5: Refusal gate races with mid-conversation removal", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CitationMapper validating only against the in-memory retrieved set lets a chip cite a source removed during answer generation."}, {"id": "_bmad_output_planning_artifacts_architecture_architecture_chaibooklm_2026_08_06_reviews_review_adversarial_h6", "label": "H6: Limits \u2014 async ingestion, retries, unowned decrements, unnamed FR-7 boundary", "file_type": "rationale", "source_file": "_bmad-output/planning-artifacts/architecture/architecture-chaibookLM-2026-08-06/reviews/review-adversarial.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetch-on-refusal source creation could double-bump or bypass caps entirely since AD-10 never named that write bo