%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#FFE500', 'primaryTextColor': '#111111', 'primaryBorderColor': '#111111', 'lineColor': '#111111', 'secondaryColor': '#00E5FF', 'tertiaryColor': '#FFFFFF'}}}%%
graph TD
    subgraph Users ["Actors"]
        User["User / Researcher\n[Browser / Mobile PWA]"]:::user
    end

    subgraph System ["Contextual System (v1)"]
        ContextualApp["Contextual Web App\n[Next.js 15 App Router + React 19]\nNeo-Brutalist Tri-Pane Workspace"]:::system
    end

    subgraph CloudInfra ["Managed External Infrastructure"]
        Clerk["Clerk\n[Identity & Authentication]"]:::external
        Inngest["Inngest Cloud\n[Durable Workflow Orchestrator & Event Bus]"]:::external
        Neon["Neon Serverless PostgreSQL\n[Metadata, Limits, Chat History, Telemetry]"]:::external
        Qdrant["Qdrant Cloud\n[Vector Store: System of Record for Chunks]"]:::external
        Cloudinary["Cloudinary CDN\n[PDF Binaries & Media Assets]"]:::external
        OpenAI["OpenAI-Compatible Endpoint\n[Embeddings 1536d + Chat LLM]"]:::external
        Firecrawl["Firecrawl API\n[Web Scraping & Clean Markdown]"]:::external
        YouTube["YouTube Captions Service\n[Video Transcript & Cue Extractor]"]:::external
        Tavily["Tavily Search API\n[Approval-Gated Live Web Fallback]"]:::external
    end

    %% User interactions
    User -->|Sign in / Manage session| Clerk
    User -->|Upload files / Paste URLs / Chat| ContextualApp
    User -->|View original PDF & YouTube clips| ContextualApp

    %% System interactions
    ContextualApp -->|Validate JWT / Session| Clerk
    ContextualApp -->|Dispatch async ingestion events| Inngest
    Inngest <==>|Execute durable step RPCs /api/inngest| ContextualApp
    ContextualApp -->|Store/query notebooks, sources, limits| Neon
    ContextualApp -->|Scoped cosine similarity search| Qdrant
    ContextualApp -->|Direct upload / fetch binary assets| Cloudinary
    ContextualApp -->|Generate embeddings & stream chat SSE| OpenAI
    ContextualApp -->|Extract clean web markdown| Firecrawl
    ContextualApp -->|Fetch YouTube captions| YouTube
    ContextualApp -->|Approval-gated search on honest refusal| Tavily

    classDef user fill:#FFE500,stroke:#111111,stroke-width:2px,color:#111111
    classDef system fill:#00E5FF,stroke:#111111,stroke-width:2px,color:#111111
    classDef external fill:#FFFFFF,stroke:#111111,stroke-width:2px,color:#111111
