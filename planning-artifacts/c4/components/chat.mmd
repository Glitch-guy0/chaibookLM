%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#FFE500', 'primaryTextColor': '#111111', 'primaryBorderColor': '#111111', 'lineColor': '#111111'}}}%%
graph TD
    subgraph ChatEndpoint ["POST /api/chat Route Handler"]
        AuthCheck["Clerk Auth & Session Validator"]:::controller
        CreditCheck["Credit Governor Gate\n[10 credits/rolling 24h]"]:::controller
        TelemetryWriter["Non-blocking Telemetry\n[telemetry_chat_prompts]"]:::telemetry
    end

    subgraph LangChainRAG ["LangChain RAG Pipeline (backend/src/contexts/chat)"]
        Retriever["QdrantScopedRetriever\n[topK=5, minScore=0.30, notebookId filter]"]:::rag
        HistoryWindow["Sliding History Buffer\n[Last 7 user+assistant turns from Neon]"]:::rag
        PromptTemplate["GroundedChatPromptTemplate\n[XML Chunk boundaries, system constraint]"]:::rag
        ModelRunner["ChatOpenAI Runnable\n[OpenAI-compatible streaming completion]"]:::rag
        CitationParser["CitationTokenParser\n[Parses [[C:chunkId]] -> Pill [1]]"]:::rag
        RefusalDetector["Refusal & Score Evaluator\n[Score < 0.30 -> Honest Refusal]"]:::rag
    end

    subgraph ExternalToolsAndStores ["Adapters & External Stores"]
        Qdrant["Qdrant Vector DB"]:::external
        NeonDB["Neon Postgres\n[chat_messages, telemetry_chat_prompts]"]:::external
        LLMEndpoint["OpenAI / LLM Endpoint"]:::external
        TavilySearch["TavilyAdapter\n[Approval-Gated Web Fallback]"]:::external
    end

    %% Flow connections
    AuthCheck --> CreditCheck
    CreditCheck -->|Credit Available| TelemetryWriter
    TelemetryWriter --> NeonDB
    CreditCheck --> Retriever
    Retriever -->|Scoped Search| Qdrant
    Retriever --> RefusalDetector

    RefusalDetector -->|Sufficient Chunks >= 0.30| PromptTemplate
    RefusalDetector -->|Insufficient Chunks / Refusal| TavilySearch

    HistoryWindow -->|Fetch Recent 7 Turns| NeonDB
    HistoryWindow --> PromptTemplate
    PromptTemplate --> ModelRunner
    ModelRunner -->|Stream SSE Tokens| CitationParser
    ModelRunner --> LLMEndpoint
    CitationParser -->|Streamed Response to Client| ClientUI["Client SSE Receiver"]:::client

    TavilySearch -->|User Approves Web Fallback| PromptTemplate

    classDef controller fill:#FFE500,stroke:#111111,stroke-width:2px,color:#111111
    classDef rag fill:#00E5FF,stroke:#111111,stroke-width:2px,color:#111111
    classDef telemetry fill:#FFF59D,stroke:#111111,stroke-width:2px,color:#111111
    classDef external fill:#FFFFFF,stroke:#111111,stroke-width:2px,color:#111111
    classDef client fill:#FFE500,stroke:#111111,stroke-width:2px,color:#111111
