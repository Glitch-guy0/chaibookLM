%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#00E5FF', 'primaryTextColor': '#111111', 'primaryBorderColor': '#111111', 'lineColor': '#111111'}}}%%
graph TD
    subgraph InngestWorkflowEngine ["Inngest Durable Workflow Engine (/api/inngest)"]
        subgraph FunctionRegistry ["Durable Ingestion Functions (Concurrency: 2/user, Retries: 3)"]
            FnText["fnIngestText\n[source.ingest.text]"]:::fn
            FnWeb["fnIngestWeb\n[source.ingest.web]"]:::fn
            FnPDF["fnIngestPDF\n[source.ingest.pdf]"]:::fn
            FnTranscript["fnIngestTranscript\n[source.ingest.transcript]"]:::fn
            FnYouTube["fnIngestYouTube\n[source.ingest.youtube]"]:::fn
        end

        subgraph FailureHandler ["Failure Isolation & Error Boundary"]
            OnFailure["onFailure Handler\n[Sets status='failed' + errorReason in Neon, purges temp upload]"]:::failure
        end

        subgraph StepPipeline ["Durable Step Function Pipeline (step.run)"]
            Step1["Step 1: extract-raw-content\n[Scrape web, fetch temp PDF, scrape YT captions]"]:::step
            Step2["Step 2: normalize-to-intermediate-markdown\n[Universal format with <!-- page/time --> anchors]"]:::step
            Step3["Step 3: chunk-intermediate-markdown\n[~500 token segments from markdown]"]:::step
            Step4["Step 4: generate-embeddings\n[Batch vector generation <= 20 chunks]"]:::step
            Step5["Step 5: index-qdrant\n[Upsert to unified contextual_chunks_v1]"]:::step
            Step6["Step 6: delete-temp-binary\n[Purge ephemeral binary from Cloudinary]"]:::step
            Step7["Step 7: update-neon-status\n[Set status='ready', chunkCount in Neon]"]:::step
        end
    end

    subgraph AdaptersAndPorts ["Backend Adapters & Services"]
        FirecrawlAdapter["FirecrawlAdapter"]:::adapter
        PDFParser["PDFPageTextExtractor (pure-JS)"]:::adapter
        YouTubeAdapter["YouTubeCaptionsAdapter (keyless)"]:::adapter
        TranscriptParser["SRT/VTT Parser"]:::adapter
        MarkdownNormalizer["Universal Markdown Normalizer"]:::adapter
        SemanticChunker["Markdown Semantic Chunker"]:::adapter
        EmbeddingsAdapter["OpenAIEmbeddingsAdapter"]:::adapter
        QdrantAdapter["QdrantAdapter (unified collection)"]:::adapter
        CloudinaryAdapter["CloudinaryAdapter (ephemeral buffer)"]:::adapter
        NeonRepository["NeonRepository"]:::adapter
    end

    %% Function routing
    FnText --> Step2
    FnWeb --> Step1
    FnPDF --> Step1
    FnTranscript --> Step1
    FnYouTube --> Step1

    FnText -.->|On Exception / Retry Exceeded| OnFailure
    FnWeb -.->|On Exception / Retry Exceeded| OnFailure
    FnPDF -.->|On Exception / Retry Exceeded| OnFailure
    FnTranscript -.->|On Exception / Retry Exceeded| OnFailure
    FnYouTube -.->|On Exception / Retry Exceeded| OnFailure
    OnFailure --> NeonRepository
    OnFailure --> CloudinaryAdapter

    %% Step execution sequence
    Step1 --> Step2 --> Step3 --> Step4 --> Step5 --> Step6 --> Step7

    %% Step to Adapters
    Step1 --> FirecrawlAdapter
    Step1 --> YouTubeAdapter
    Step1 --> CloudinaryAdapter
    Step2 --> PDFParser
    Step2 --> TranscriptParser
    Step2 --> MarkdownNormalizer
    Step3 --> SemanticChunker
    Step4 --> EmbeddingsAdapter
    Step5 --> QdrantAdapter
    Step6 --> CloudinaryAdapter
    Step7 --> NeonRepository

    classDef fn fill:#FFE500,stroke:#111111,stroke-width:2px,color:#111111
    classDef step fill:#FFFFFF,stroke:#111111,stroke-width:2px,color:#111111
    classDef failure fill:#FF3B30,stroke:#111111,stroke-width:2px,color:#FFFFFF
    classDef adapter fill:#F4F4F0,stroke:#111111,stroke-width:2px,color:#111111
