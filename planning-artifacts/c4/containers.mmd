%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#FFE500', 'primaryTextColor': '#111111', 'primaryBorderColor': '#111111', 'lineColor': '#111111'}}}%%
graph TD
    subgraph ClientLayer ["Client Layer [Next.js 15 Client / React 19]"]
        Browser["Tri-Pane Workspace UI\n[Sources Pane | Chat Pane | Showcase Pane]\nNeo-Brutalist Design System + Tailwind CSS"]:::client
    end

    subgraph ServerlessApp ["Next.js App Router (Presentation & Controllers)"]
        RouteSources["POST /api/sources\n[Upload & Event Dispatch]"]:::controller
        RouteChat["POST /api/chat\n[RAG Retrieval & SSE Stream]"]:::controller
        RouteInngest["ALL /api/inngest\n[Inngest Worker Gateway]"]:::controller
        RouteNotebooks["/api/notebooks\n[CRUD & Quota Guard]"]:::controller
    end

    subgraph BackendTree ["Backend Tree (backend/src) — Modular Monolith"]
        subgraph BoundedContexts ["Bounded Contexts (Domain & Application)"]
            NotebooksCtx["notebooks Context\n[CRUD, 10-cap, Midnight TTL]"]:::domain
            SourcesCtx["sources Context\n[State: queued|indexing|ready|failed]"]:::domain
            ChatCtx["chat Context\n[LangChain RAG, [[C:chunkId]], Refusal]"]:::domain
            IngestionCtx["ingestion Context\n[Input -> Process -> Text -> Index]"]:::domain
            LimitsCtx["limits Context\n[10 Credits/Rolling 24h, Storage Caps]"]:::domain
            TelemetryCtx["telemetry Context\n[Chat Prompts & File Uploads]"]:::domain
        end

        subgraph SharedKernel ["Shared Kernel"]
            CanonicalChunk["Canonical Chunk Model\n[chunkId, sourceId, notebookId, text, metadata]"]:::kernel
            CitationTokens["Citation Token Protocol\n[[[C:chunkId]] -> Pill [1]]"]:::kernel
        end

        subgraph Ports ["Ports & Interfaces"]
            VectorStorePort["VectorStore Port"]:::port
            StoragePort["StorageService Port"]:::port
            EmbeddingsPort["Embeddings Port"]:::port
            SearchPort["Search Port"]:::port
            WebExtractorPort["WebExtractor Port"]:::port
            CaptionsPort["CaptionsService Port"]:::port
        end

        subgraph Adapters ["Composite Adapters"]
            QdrantAdapter["QdrantAdapter"]:::adapter
            NeonAdapter["NeonRepository"]:::adapter
            CloudinaryAdapter["CloudinaryAdapter"]:::adapter
            OpenAIAdapter["OpenAIEmbeddingsAdapter"]:::adapter
            TavilyAdapter["TavilyAdapter"]:::adapter
            FirecrawlAdapter["FirecrawlAdapter"]:::adapter
            YouTubeAdapter["YouTubeCaptionsAdapter"]:::adapter
        end
    end

    subgraph ExternalCloud ["External Managed Cloud Services"]
        Qdrant[("Qdrant Cloud\n[Vectors + Chunk Text]")]:::external
        Neon[("Neon Postgres\n[Metadata, Limits, Telemetry]")]:::external
        Cloudinary["Cloudinary Storage\n[PDF Binaries]"]:::external
        OpenAI["OpenAI Endpoint\n[Embeddings + Chat LLM]"]:::external
        Firecrawl["Firecrawl API\n[Clean Markdown]"]:::external
        YouTubeService["YouTube Captions\n[SRT/VTT Cues]"]:::external
        Tavily["Tavily Search\n[Live Web Fallback]"]:::external
        InngestCloud["Inngest Event Bus & Engine\n[Durable Step Orchestration]"]:::external
    end

    %% Client to Routes
    Browser -->|Upload PDF/URL/Text| RouteSources
    Browser -->|Prompt & SSE Streaming| RouteChat
    Browser -->|Notebook List / Manage| RouteNotebooks

    %% Routes to Backend
    RouteSources --> SourcesCtx
    RouteSources --> LimitsCtx
    RouteSources --> TelemetryCtx
    RouteSources -->|Dispatch source.ingest.*| InngestCloud
    RouteChat --> ChatCtx
    RouteChat --> LimitsCtx
    RouteChat --> TelemetryCtx
    RouteNotebooks --> NotebooksCtx
    RouteInngest <==>|Step RPC Execution| InngestCloud
    InngestCloud --> IngestionCtx

    %% Contexts to Ports & Shared Kernel
    NotebooksCtx --> StoragePort
    NotebooksCtx --> VectorStorePort
    SourcesCtx --> StoragePort
    SourcesCtx --> VectorStorePort
    ChatCtx --> VectorStorePort
    ChatCtx --> SearchPort
    ChatCtx --> SharedKernel
    IngestionCtx --> StoragePort
    IngestionCtx --> VectorStorePort
    IngestionCtx --> EmbeddingsPort
    IngestionCtx --> WebExtractorPort
    IngestionCtx --> CaptionsPort
    IngestionCtx --> SharedKernel
    LimitsCtx --> StoragePort
    TelemetryCtx --> StoragePort

    %% Ports to Adapters
    VectorStorePort --> QdrantAdapter
    StoragePort --> NeonAdapter
    StoragePort --> CloudinaryAdapter
    EmbeddingsPort --> OpenAIAdapter
    SearchPort --> TavilyAdapter
    WebExtractorPort --> FirecrawlAdapter
    CaptionsPort --> YouTubeAdapter

    %% Adapters to External
    QdrantAdapter --> Qdrant
    NeonAdapter --> Neon
    CloudinaryAdapter --> Cloudinary
    OpenAIAdapter --> OpenAI
    TavilyAdapter --> Tavily
    FirecrawlAdapter --> Firecrawl
    YouTubeAdapter --> YouTubeService

