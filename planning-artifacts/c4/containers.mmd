    classDef kernel fill:#FFF59D,stroke:#111111,stroke-width:2px,color:#111111
    classDef port fill:#E0E0E0,stroke:#111111,stroke-width:2px,color:#111111
    classDef adapter fill:#F4F4F0,stroke:#111111,stroke-width:2px,color:#111111
    classDef external fill:#FFFFFF,stroke:#111111,stroke-width:2px,color:#111111
